     for entry in fs::read_dir(&target)? {
         let entry = entry?;
-        std::os::unix::fs::symlink(entry.path(), dir.join(entry.file_name()))?;
+        link_or_copy(&entry.path(), &dir.join(entry.file_name()))?;
     }
     Ok(())
 }
