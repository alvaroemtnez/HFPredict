# Build environments for HFPredict. The host only needs podman; the Rust
# toolchain itself comes from .tools/ (tools/rust.sh), mounted in.

# GNOME app development: GTK 4.18 and libadwaita 1.7 (the oldest versions
# the app supports, and what the AppImage bundles), plus a headless Wayland
# compositor and fonts for screenshots.
FROM docker.io/library/debian:trixie-slim AS gnome
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config ca-certificates curl git \
      libgtk-4-dev libadwaita-1-dev librsvg2-common \
      weston dbus dbus-x11 fonts-cantarell fonts-noto-core fonts-noto-cjk adwaita-icon-theme \
      librsvg2-bin python3 desktop-file-utils appstream file \
 && rm -rf /var/lib/apt/lists/*

# Windows builds, cross-compiled: Fedora's MinGW GTK 4 and AppStream, and
# libadwaita 1.7 built here (Fedora packages no MinGW libadwaita). Used by
# packaging/windows/build.sh only; Linux builds never touch it.
FROM registry.fedoraproject.org/fedora:44 AS windows
RUN dnf -y install --setopt=install_weak_deps=False \
      mingw64-gcc mingw64-gtk4 mingw64-appstream mingw64-adwaita-icon-theme \
      mingw64-librsvg2 mingw64-pkg-config mingw64-hicolor-icon-theme \
      gcc meson ninja-build sassc gettext glib2-devel python3 curl xz zip findutils patch \
 && dnf clean all
ARG ADW_VERSION=1.7.12
ARG ADW_SHA256=94c41ab41c2d2188af8290ac0dbb906896cf75e76e69722c2ea2572531de3308
RUN curl -fsSL "https://download.gnome.org/sources/libadwaita/1.7/libadwaita-$ADW_VERSION.tar.xz" -o /tmp/adw.tar.xz \
 && echo "$ADW_SHA256  /tmp/adw.tar.xz" | sha256sum -c - \
 && tar -C /tmp -xf /tmp/adw.tar.xz \
 && cd "/tmp/libadwaita-$ADW_VERSION" \
 && meson setup build --cross-file /usr/share/mingw/toolchain-mingw64.meson \
      --prefix /usr/x86_64-w64-mingw32/sys-root/mingw --buildtype release \
      -Dintrospection=disabled -Dvapi=false -Dgtk_doc=false -Dtests=false -Dexamples=false \
 && ninja -C build install \
 && rm -rf /tmp/adw.tar.xz "/tmp/libadwaita-$ADW_VERSION"
